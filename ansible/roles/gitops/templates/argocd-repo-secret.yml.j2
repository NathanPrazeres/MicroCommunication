---
apiVersion: v1
kind: Secret
metadata:
  name: private-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: git@github.com:{{ git_repo_org }}/{{ argocd_repo_name }}
  sshPrivateKey: |-
{{ lookup('file', argocd_repo_ssh_key_path) | indent(4) }}

