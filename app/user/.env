DATABASE_URL=postgres://admin:admin@localhost:5432/user_service

# Redis
REDIS_URL="redis://localhost:6379"  # "redis://redis:6379"
REDIS_TTL_SECONDS=3600
REDIS_CACHE_ENABLED=true

# Keycloak Public Key
KEYCLOAK_URL="http://localhost:8080" # http://keycloak:8080"
KEYCLOAK_REALM="app"

# Service config
SERVICE_PORT=3000

# Rust
RUST_LOG=info
RUST_BACKTRACE=1

SQLX_OFFLINE=true

# Environment
ENVIRONMENT=development
