  "query": "\n        UPDATE user_contacts\n        SET\n            nickname = COALESCE($3, nickname),\n            is_favorite = COALESCE($4, is_favorite),\n            is_blocked = COALESCE($5, is_blocked),\n            updated_at = NOW()\n        WHERE user_id = $1 AND contact_id = $2\n        RETURNING *\n        ",
