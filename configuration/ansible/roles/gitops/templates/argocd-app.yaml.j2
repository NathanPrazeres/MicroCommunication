apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ argocd_app_name | default('my-app') }}
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ argocd_app_repo }}
    targetRevision: {{ argocd_app_revision | default('HEAD') }}
    path: {{ argocd_app_path }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ argocd_app_namespace | default('default') }}
  syncPolicy:
    automated:
      prune: {{ argocd_auto_prune | default(true) }}
      selfHeal: {{ argocd_auto_heal | default(true) }}
    syncOptions:
      - CreateNamespace=true
      - PruneLast=true
