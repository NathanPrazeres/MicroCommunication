{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                u.user_id,\n                u.username,\n                u.first_name,\n                u.last_name,\n                u.avatar_url,\n                u.bio,\n                u.email,\n                u.phone_number,\n                u.is_online,\n                u.last_seen,\n                uc.nickname,\n                uc.is_favorite,\n                uc.is_blocked,\n                uc.created_at as contact_since\n            FROM user_contacts uc\n            INNER JOIN user_profiles u ON u.user_id = uc.contact_id\n            WHERE uc.user_id = $1\n            AND uc.is_blocked = false\n            ORDER BY uc.is_favorite DESC, uc.created_at DESC\n            ",
